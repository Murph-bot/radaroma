# Copy to `.dev.vars` for `npm run preview` (wrangler reads this file for local dev).
# These mirror the server-only vars in `.env.local`; NEXT_PUBLIC_* vars are inlined
# at build time and don't need to be here.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o
LLM_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3000
