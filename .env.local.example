# Radaroma environment variables
# Copy to `.env.local` for `next dev` / `next build`.
# Server-only secrets also go into `.dev.vars` for `npm run preview` and
# `wrangler secret put` for production.
#
# The database is Cloudflare D1 (SQLite) — no env vars needed, it arrives
# as the `DB` binding via wrangler.jsonc.

# --- LLM (OpenRouter) ---
# Your OpenRouter API key (https://openrouter.ai/keys)
LLM_API_KEY=sk-or-...
# Default model; any OpenRouter slug works
LLM_MODEL=openai/gpt-4o
# Provider base URL; default is OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- App ---
# Canonical site URL (used for links, metadata, agent headers)
APP_URL=http://localhost:3000

# --- Local admin only (NEVER set in production) ---
# Lets you into /admin locally without Cloudflare Access. The email must
# still be in the invited_emails allowlist. Set the flag to 1 in .dev.vars
# for wrangler preview; never add either var as a prod secret.
ADMIN_EMAIL=you@example.com
POUR_COMPASS_DEV_ADMIN=1
