# Pour Compass environment variables
# Copy to `.env.local` for `next dev` / `next build` (NEXT_PUBLIC_* are inlined at build time).
# Server-only secrets also go into `.dev.vars` for `npm run preview` and
# `wrangler secret put` for production.

# --- Supabase ---
# Project URL (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only! never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM (OpenRouter) ---
# Your OpenRouter API key (https://openrouter.ai/keys)
LLM_API_KEY=sk-or-...
# Default model; any OpenRouter slug works
LLM_MODEL=openai/gpt-4o
# Provider base URL; default is OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- App ---
# Canonical site URL (used for links, metadata, agent headers)
APP_URL=http://localhost:3000
